OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Timezone padrão do negócio (ex.: America/Recife, America/Sao_Paulo)
BUSINESS_TIMEZONE=America/Recife

# Duração padrão do exame (min)
EXAM_DURATION_MIN=30

# Horário comercial (local)
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00

# Google Calendar
GOOGLE_CALENDAR_ID=primary

# Opção A: Service Account
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_WORKSPACE_SUBJECT_EMAIL=

# Opção B: OAuth (token gerado por script)
GOOGLE_OAUTH_CLIENT_FILE=backend/credentials.json
GOOGLE_OAUTH_TOKEN_FILE=backend/token.json

# Persistência
SQLITE_PATH=backend/app.db
